# ==============================================================================
# Orbyte / InvoisReady Server Environment Variables Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env.local' for local development or configure these
#    variables in your deployment environment (e.g., Docker, Railway, Render, etc.).
# 2. Fill in your valid API keys and endpoints below.
# 3. SECURITY NOTICE: All keys are consumed strictly server-side.
#    NEVER expose these values in frontend bundles or VITE_* prefixed variables.
# ==============================================================================

# Server Configuration
PORT=3000

# Google Gemini API Key (Required for AI Chatbot, Policy Q&A, and Compliance Assistant)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Supabase Database & Vector Storage (Required for Policy Q&A Knowledge Base)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Supabase Secret Key (Optional server-side service role fallback)
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# OpenAI API Key (Optional secondary fallback provider)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# AI Provider Routing & Priority ('gemini,openai' or 'gemini')
AI_PROVIDER_ORDER=gemini,openai
POLICY_QA_PROVIDER_ORDER=gemini,openai

# Default AI Models
AI_GEMINI_MODEL=gemini-3.8-flash
AI_OPENAI_MODEL=gpt-4.1-mini
POLICY_QA_GEMINI_MODEL=gemini-3.8-flash
POLICY_QA_OPENAI_MODEL=gpt-4.1-mini

# Application Host URL
APP_URL=http://localhost:3000
